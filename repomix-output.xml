  font-size: 11px;
  outline: none;
}


/* STATS */

.market-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15px;
  margin-bottom: 18px;
}

.market-stat-card {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 21px;
  border: 1px solid #e5e9f0;
  border-radius: 14px;
  background: white;
}

.stat-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 17px;
  font-weight: 800;
}

.stat-icon.blue {
  background: #edf1ff;
  color: #3461ff;
}

.stat-icon.purple {
  background: #f2edff;
  color: #8055d6;
}

.stat-icon.green {
  background: #eaf9f0;
  color: #199455;
}

.stat-icon.orange {
  background: #fff2e7;
  color: #e98229;
}

.market-stat-card span {
  display: block;
  margin-bottom: 5px;
  color: #929baa;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.market-stat-card strong {
  display: block;
  color: #172033;
  font-size: 17px;
}

.market-stat-card small {
  display: block;
  margin-top: 4px;
  color: #199455;
  font-size: 9px;
}


/* CHART GRID */

.market-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.market-card {
  padding: 25px;
  border: 1px solid #e5e9f0;
  border-radius: 15px;
  background: white;
}

.market-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 25px;
}

.market-card-header h3 {
  color: #20283a;
  font-size: 15px;
  margin-bottom: 5px;
}

.market-card-header p {
  color: #929baa;
  font-size: 10px;
}

.trend-positive {
  padding: 6px 8px;
  border-radius: 6px;
  background: #eaf9f0;
  color: #199455;
  font-size: 9px;
  font-weight: 800;
}


/* BHK CHART */

.bhk-chart {
  display: flex;
  flex-direction: column;
  gap: 21px;
}

.bhk-row {
  display: grid;
  grid-template-columns: 55px 1fr 70px;
  align-items: center;
  gap: 10px;
}

.bhk-label {
  color: #667185;
  font-size: 10px;
  font-weight: 700;
}

.bhk-bar-container {
  height: 10px;
  overflow: hidden;
  border-radius: 20px;
  background: #edf0f5;
}

.bhk-bar {
  height: 100%;
  border-radius: 20px;
  background: #3461ff;
}

.bhk-price {
  color: #283247;
  font-size: 10px;
  font-weight: 800;
  text-align: right;
}


/* TREND CHART */

.trend-chart {
  height: 210px;
  display: flex;
  gap: 12px;
}

.chart-y-axis {
  height: 175px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #a0a8b5;
  font-size: 8px;
}

.chart-area {
  position: relative;
  flex: 1;
  height: 175px;
}

.grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: #edf0f4;
}

.line-1 {
  top: 0;
}

.line-2 {
  top: 25%;
}

.line-3 {
  top: 50%;
}

.line-4 {
  top: 75%;
}

.line-5 {
  bottom: 0;
}

.trend-line {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.trend-line::before {
  content: "";
  position: absolute;
  left: 2%;
  right: 2%;
  top: 43%;
  height: 2px;
  background: #3461ff;
  transform: rotate(-2deg);
  transform-origin: left center;
  box-shadow: 60px 18px 0 -0.5px #3461ff;
}

.point {
  position: absolute;
  width: 8px;
  height: 8px;
  border: 2px solid white;
  border-radius: 50%;
  background: #3461ff;
  box-shadow: 0 0 0 2px #3461ff;
}

.p1 {
  left: 3%;
  top: 54%;
}

.p2 {
  left: 21%;
  top: 47%;
}

.p3 {
  left: 39%;
  top: 51%;
}

.p4 {
  left: 57%;
  top: 38%;
}

.p5 {
  left: 75%;
  top: 34%;
}

.p6 {
  left: 94%;
  top: 25%;
}

.chart-months {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -25px;
  display: flex;
  justify-content: space-between;
  color: #9ba3b1;
  font-size: 8px;
}


/* LOCALITY TABLE */

.locality-card {
  margin-bottom: 18px;
}

.locality-table-wrapper {
  overflow-x: auto;
}

.locality-table {
  width: 100%;
  min-width: 600px;
  border-collapse: collapse;
}

.locality-table th,
.locality-table td {
  padding: 15px;
  border-bottom: 1px solid #edf0f4;
  text-align: left;
  font-size: 11px;
}

.locality-table th {
  background: #f8faff;
