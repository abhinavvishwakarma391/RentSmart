  font-size: 9px;
  font-weight: 800;
}

.locality-table td {
  color: #697386;
}

.locality-table tr:last-child td {
  border-bottom: none;
}

.locality-table strong {
  color: #283247;
}

.change-up,
.change-down {
  font-weight: 800;
}

.change-up {
  color: #e07832;
}

.change-down {
  color: #199455;
}

.market-status {
  display: inline-block;
  padding: 6px 9px;
  border-radius: 6px;
  background: #edf1ff;
  color: #3461ff;
  font-size: 8px;
  font-weight: 800;
