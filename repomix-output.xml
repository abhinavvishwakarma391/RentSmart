}

.market-header h1 {
  margin: 10px 0 18px;
  color: #172033;
  font-size: clamp(40px, 5vw, 58px);
  line-height: 1.05;
  letter-spacing: -2.5px;
}

.market-header h1 span {
  color: #3461ff;
}

.market-header p {
  max-width: 600px;
