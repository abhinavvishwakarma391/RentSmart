.predict-page {
  min-height: 100vh;
  background: #f8faff;
}

.predict-header {
  padding: 75px 28px 55px;
  background: white;
  border-bottom: 1px solid #edf0f5;
}

.predict-header-content {
  max-width: 850px;
  margin: auto;
  text-align: center;
}

.predict-header h1 {
  margin: 10px 0 18px;

  color: #172033;
  font-size: clamp(40px, 5vw, 58px);
  line-height: 1.05;
  letter-spacing: -2.5px;
}

.predict-header h1 span {
  color: #3461ff;
}

.predict-header p {
  max-width: 600px;
  margin: auto;

  color: #7d8697;
  font-size: 15px;
  line-height: 1.7;
}


/* MAIN */

.predict-section {
  padding: 60px 28px 100px;
}

.predict-container {
  max-width: 1080px;
  margin: auto;

  display: grid;
  grid-template-columns: 1fr 0.8fr;
  gap: 30px;
  align-items: start;
}


/* FORM CARD */

.predict-form-card {
  padding: 32px;

  border: 1px solid #e5e9f0;
  border-radius: 18px;

  background: white;

  box-shadow:
    0 12px 35px rgba(28, 43, 70, 0.06);
}

.form-heading {
  margin-bottom: 28px;
}

.form-heading h2 {
  color: #172033;
  font-size: 21px;
  margin-bottom: 6px;
}

.form-heading p {
  color: #8a93a3;
  font-size: 12px;
}


/* FORM */

.form-group {
  position: relative;
  margin-bottom: 21px;
}

.form-group > label {
  display: block;

  margin-bottom: 8px;

  color: #354056;
  font-size: 12px;
  font-weight: 700;
}

.form-group input[type="text"],
.form-group input[type="number"],
.form-group select {
  width: 100%;
  height: 45px;

  padding: 0 13px;

  border: 1px solid #dfe4ec;
  border-radius: 8px;

  outline: none;

  background: white;
  color: #283247;

  font-size: 13px;

  transition: 0.2s;
}

.form-group input:focus,
.form-group select:focus {
  border-color: #3461ff;
  box-shadow: 0 0 0 3px rgba(52, 97, 255, 0.08);
}

.form-group input::placeholder {
  color: #a7afbd;
}

.form-group small {
  position: absolute;
  right: 13px;
  bottom: 13px;

  color: #9aa2b0;
  font-size: 10px;
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}


/* RADIO */

.option-group {
  display: flex;
  gap: 10px;
}

.radio-option {
  flex: 1;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 11px 13px;

  border: 1px solid #dfe4ec;
  border-radius: 8px;

  color: #4d586d;
  font-size: 12px;

  cursor: pointer;
}

.radio-option input {
  accent-color: #3461ff;
}


/* BUTTON */

.predict-button {
  width: 100%;
  height: 48px;

  margin-top: 5px;

  border: none;
  border-radius: 9px;

  background: #3461ff;
  color: white;

  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;

  transition: 0.2s;
}

.predict-button:hover {
  background: #2854e9;
  transform: translateY(-1px);
}

.predict-button:disabled {
  opacity: 0.7;
  cursor: not-allowed;
  transform: none;
}

.form-error {
  margin: 8px 0 0;
  color: #c0392b;
  font-size: 13px;
}


/* RESULT */

.prediction-result {
  min-height: 430px;
}

.result-empty,
.result-card {
  height: 100%;

  padding: 32px;

  border-radius: 18px;

  background: #172033;

  color: white;
}


/* EMPTY */

.result-empty {
  min-height: 430px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  text-align: center;
}

.result-icon {
  width: 58px;
  height: 58px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 20px;

  border-radius: 15px;

  background: rgba(52, 97, 255, 0.2);
  color: #7e9aff;

  font-size: 23px;
  font-weight: 800;
}

.result-empty h3 {
  margin-bottom: 9px;

  font-size: 19px;
}

.result-empty > p {
  max-width: 280px;

  color: #8c97ac;
  font-size: 12px;
  line-height: 1.7;
}

.result-tips {
  margin-top: 27px;

  display: flex;
  flex-direction: column;
  gap: 9px;

  color: #a8b1c3;
  font-size: 10px;
}


/* RESULT CARD */

.result-card {
  min-height: 430px;
}

.result-label {
  color: #8e9ab0;

  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.2px;
}

.result-price {
  margin: 14px 0 17px;

  color: white;

  font-size: 42px;
  font-weight: 800;
  letter-spacing: -2px;
}

.result-price small {
  color: #8e9ab0;

  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0;
}

.price-status {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  padding: 8px 11px;

  border-radius: 7px;

  background: rgba(40, 194, 119, 0.12);
  color: #55d99a;

  font-size: 10px;
  font-weight: 800;
}

.price-range {
  margin-top: 28px;
  padding-top: 22px;

  border-top: 1px solid #2c3648;
}

.price-range p {
  margin-bottom: 6px;

  color: #8e9ab0;
  font-size: 10px;
}

.price-range strong {
  color: #dce3ef;
  font-size: 15px;
}

.result-note {
  margin-top: 27px;
}

.result-note strong {
  font-size: 12px;
}

.result-note p {
  margin-top: 7px;

  color: #8e9ab0;

  font-size: 10px;
  line-height: 1.7;
}

.result-action {
  display: inline-block;

  margin-top: 25px;

  color: #7892ff;

  font-size: 11px;
  font-weight: 800;
}


/* RESPONSIVE */

@media (max-width: 850px) {

  .predict-container {
    grid-template-columns: 1fr;
  }

  .prediction-result {
    min-height: auto;
  }

  .result-empty,
  .result-card {
    min-height: 380px;
  }
}

@media (max-width: 600px) {

  .predict-header {
    padding: 55px 20px 40px;
  }

  .predict-section {
    padding: 35px 18px 70px;
  }

  .predict-form-card {
    padding: 23px;
  }

  .form-row {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .result-price {
    font-size: 34px;
  }
}
