          path="/"
          element={<Home />}
        />

        <Route
          path="/predict"
          element={<PredictRent />}
        />

        <Route
  path="/compare"
  element={<Compare />}
/>

        <Route
  path="/recommendations"
  element={<Recommendations />}
/>

        <Route
  path="/market"
  element={<MarketAnalysis />}
/>

        <Route
  path="/about"
  element={<About />}
/>

      </Routes>

    </BrowserRouter>
  );
}

export default App;
