.about-feature p {
  color: #7d8697;
  font-size: 11px;
  line-height: 1.7;
}


/* TECHNOLOGY */

.technology-section {
  padding: 90px 28px;

  background: #172033;
  color: white;
}

.technology-content {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 90px;
  align-items: center;
}

.technology-content h2 {
  margin: 10px 0 17px;

  color: white;

  font-size: 36px;
  line-height: 1.15;
  letter-spacing: -1px;
}

.technology-content h2 span {
  color: #7892ff;
}

.technology-content p {
  color: #8e9ab0;
  font-size: 12px;
  line-height: 1.8;
}

.technology-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.technology-grid > div {
  padding: 20px;

  border: 1px solid #2c3648;
  border-radius: 11px;

  background: #1c2637;
}

.technology-grid strong {
  display: block;

  margin-bottom: 5px;

  color: white;
  font-size: 14px;
}

.technology-grid span {
  color: #7e899e;
  font-size: 9px;
}


/* CTA */

.about-cta {
  padding: 75px 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;

  background: #101725;
  color: white;
}

.about-cta > div:first-child {
  max-width: 1184px;
}

.about-cta h2 {
  margin-top: 8px;

  color: white;
  font-size: 32px;
  line-height: 1.2;
}

.about-cta h2 span {
  color: #7892ff;
}

.about-cta .cta-button {
  margin-right: 8%;
}


/* RESPONSIVE */

@media (max-width: 900px) {

  .about-two-column {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .about-steps {
    grid-template-columns: 1fr 1fr;
  }

  .technology-content {
    grid-template-columns: 1fr;
    gap: 40px;
  }

}

@media (max-width: 600px) {

  .about-section,
  .about-process,
  .technology-section {
    padding: 65px 20px;
  }

  .about-steps {
    grid-template-columns: 1fr;
  }

  .about-feature-grid {
    grid-template-columns: 1fr;
  }

  .technology-grid {
    grid-template-columns: 1fr;
  }

  .about-cta {
    padding: 60px 20px;

    flex-direction: column;
    align-items: flex-start;
  }

  .about-cta .cta-button {
    margin-right: 0;
  }

}
