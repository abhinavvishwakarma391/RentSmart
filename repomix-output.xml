                        <span>
                          🛋 {property.furnishing}
                        </span>

                        <span>
                          🚗 {property.parking}
                        </span>

                        <span>
                          {property.status_label}
                        </span>

                      </div>


                      <div className="recommend-bottom">

                        <div className="match-score">

                          <div className="match-circle">
