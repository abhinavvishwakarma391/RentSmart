  border: 1px solid #e5e9f0;
  border-radius: 14px;
  background: white;
}

.stat-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 17px;
  font-weight: 800;
}

.stat-icon.blue {
  background: #edf1ff;
  color: #3461ff;
}

.stat-icon.purple {
  background: #f2edff;
  color: #8055d6;
}

.stat-icon.green {
  background: #eaf9f0;
  color: #199455;
}

.stat-icon.orange {
  background: #fff2e7;
  color: #e98229;
}

.market-stat-card span {
  display: block;
  margin-bottom: 5px;
  color: #929baa;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 0.8px;
}

.market-stat-card strong {
  display: block;
  color: #172033;
  font-size: 17px;
}

.market-stat-card small {
  display: block;
  margin-top: 4px;
  color: #199455;
  font-size: 9px;
}


/* CHART GRID */

.market-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}

.market-card {
  padding: 25px;
  border: 1px solid #e5e9f0;
  border-radius: 15px;
  background: white;
}

.market-card-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 25px;
}

.market-card-header h3 {
  color: #20283a;
  font-size: 15px;
  margin-bottom: 5px;
}

.market-card-header p {
  color: #929baa;
  font-size: 10px;
}

.trend-positive {
  padding: 6px 8px;
  border-radius: 6px;
  background: #eaf9f0;
  color: #199455;
  font-size: 9px;
  font-weight: 800;
}


/* BHK CHART */

.bhk-chart {
  display: flex;
  flex-direction: column;
  gap: 21px;
}

.bhk-row {
  display: grid;
  grid-template-columns: 55px 1fr 70px;
  align-items: center;
  gap: 10px;
}

.bhk-label {
  color: #667185;
  font-size: 10px;
  font-weight: 700;
}

.bhk-bar-container {
  height: 10px;
  overflow: hidden;
  border-radius: 20px;
  background: #edf0f5;
}

.bhk-bar {
  height: 100%;
  border-radius: 20px;
  background: #3461ff;
}

.bhk-price {
  color: #283247;
  font-size: 10px;
  font-weight: 800;
  text-align: right;
}


/* TREND CHART */

.trend-chart {
  height: 210px;
  display: flex;
  gap: 12px;
}

.chart-y-axis {
  height: 175px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: #a0a8b5;
  font-size: 8px;
}

.chart-area {
  position: relative;
  flex: 1;
  height: 175px;
}

.grid-line {
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: #edf0f4;
}

.line-1 {
  top: 0;
}

.line-2 {
  top: 25%;
}

.line-3 {
  top: 50%;
}

.line-4 {
  top: 75%;
}

.line-5 {
  bottom: 0;
}

.trend-line {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.trend-line::before {
  content: "";
  position: absolute;
  left: 2%;
  right: 2%;
  top: 43%;
  height: 2px;
  background: #3461ff;
  transform: rotate(-2deg);
  transform-origin: left center;
  box-shadow: 60px 18px 0 -0.5px #3461ff;
}

.point {
  position: absolute;
  width: 8px;
  height: 8px;
  border: 2px solid white;
  border-radius: 50%;
  background: #3461ff;
  box-shadow: 0 0 0 2px #3461ff;
}

.p1 {
  left: 3%;
  top: 54%;
}

.p2 {
  left: 21%;
  top: 47%;
}

.p3 {
  left: 39%;
  top: 51%;
}

.p4 {
  left: 57%;
  top: 38%;
}

.p5 {
  left: 75%;
  top: 34%;
}

.p6 {
  left: 94%;
  top: 25%;
}

.chart-months {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -25px;
  display: flex;
  justify-content: space-between;
  color: #9ba3b1;
  font-size: 8px;
}


/* LOCALITY TABLE */

.locality-card {
  margin-bottom: 18px;
}

.locality-table-wrapper {
  overflow-x: auto;
}

.locality-table {
  width: 100%;
  min-width: 600px;
  border-collapse: collapse;
}

.locality-table th,
.locality-table td {
  padding: 15px;
  border-bottom: 1px solid #edf0f4;
  text-align: left;
  font-size: 11px;
}

.locality-table th {
  background: #f8faff;
  color: #778196;
  font-size: 9px;
  font-weight: 800;
}

.locality-table td {
  color: #697386;
}

.locality-table tr:last-child td {
  border-bottom: none;
}

.locality-table strong {
  color: #283247;
}

.change-up,
.change-down {
  font-weight: 800;
}

.change-up {
  color: #e07832;
}

.change-down {
  color: #199455;
}

.market-status {
  display: inline-block;
  padding: 6px 9px;
  border-radius: 6px;
  background: #edf1ff;
  color: #3461ff;
  font-size: 8px;
  font-weight: 800;
}


/* INSIGHT */

.market-insight {
  display: flex;
  align-items: flex-start;
  gap: 16px;
  padding: 23px;
  border-radius: 15px;
  background: #172033;
  color: white;
}

.insight-icon {
  width: 43px;
  height: 43px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 11px;
  background: rgba(52, 97, 255, 0.2);
  color: #7892ff;
  font-size: 17px;
}

.market-insight span {
  color: #7892a9;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: 1px;
}

.market-insight h3 {
  margin: 6px 0;
  color: white;
  font-size: 15px;
}

.market-insight p {
  max-width: 750px;
  color: #8e9ab0;
  font-size: 10px;
  line-height: 1.7;
}


/* RESPONSIVE */

@media (max-width: 950px) {
  .market-stats {
    grid-template-columns: 1fr 1fr;
  }

  .market-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .market-section {
    padding: 40px 18px 70px;
  }

  .market-toolbar {
    align-items: flex-start;
    gap: 15px;
  }

  .market-stats {
    grid-template-columns: 1fr;
  }

  .market-stat-card {
    max-width: 100%;
  }

  .market-card {
    padding: 20px;
  }

  .market-insight {
    flex-direction: column;
  }
}
/* ================= ABOUT PAGE ================= */

.about-page {
  min-height: 100vh;
  background: white;
}

.about-hero {
  padding: 90px 28px 80px;
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(52, 97, 255, 0.09),
      transparent 30%
    ),
    #f8faff;
  border-bottom: 1px solid #edf0f5;
}

.about-hero-content {
  max-width: 850px;
  margin: auto;
  text-align: center;
}

.about-hero h1 {
  margin: 12px 0 20px;

  color: #172033;
  font-size: clamp(42px, 5vw, 62px);
  line-height: 1.05;
  letter-spacing: -2.5px;
}

.about-hero h1 span {
  color: #3461ff;
}

.about-hero p {
  max-width: 650px;
  margin: auto;

  color: #7d8697;
  font-size: 15px;
  line-height: 1.8;
}


/* MAIN SECTION */

.about-section {
  padding: 95px 28px;
}

.about-container {
  max-width: 1184px;
  margin: auto;
}

.about-two-column {
  display: grid;
  grid-template-columns: 0.9fr 1fr;
  gap: 100px;
  align-items: start;
}

.about-two-column h2 {
  color: #172033;
  font-size: 38px;
  line-height: 1.15;
  letter-spacing: -1.5px;
}

.about-two-column h2 span {
  color: #3461ff;
}

.about-large-text {
  margin-bottom: 18px;

  color: #354056;
  font-size: 18px;
  line-height: 1.7;
}

.about-two-column p:not(.about-large-text) {
  color: #7d8697;
  font-size: 13px;
  line-height: 1.8;
}


/* PROCESS */

.about-process {
  padding: 95px 28px;
  background: #f8faff;
}

.about-steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
  margin-top: 50px;
}

.about-step {
  padding: 25px;

  border: 1px solid #e5e9f0;
  border-radius: 14px;

  background: white;
}

.about-step-number {
  width: 42px;
  height: 42px;

  display: flex;
  align-items: center;
  justify-content: center;

  margin-bottom: 20px;

  border-radius: 10px;

  background: #edf1ff;
  color: #3461ff;

  font-size: 10px;
  font-weight: 800;
}

.about-step h3 {
  margin-bottom: 9px;

  color: #20283a;
  font-size: 15px;
}

.about-step p {
  color: #7d8697;
  font-size: 11px;
  line-height: 1.7;
}


/* FEATURES */

.about-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 15px;
  margin-top: 45px;
}

.about-feature {
  display: flex;
  gap: 16px;

  padding: 24px;

  border: 1px solid #e5e9f0;
  border-radius: 14px;

  background: white;
}

.about-feature-icon {
  width: 43px;
  height: 43px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  background: #edf1ff;
  color: #3461ff;

  font-size: 17px;
  font-weight: 800;
}

.about-feature h3 {
  margin-bottom: 7px;

  color: #20283a;
  font-size: 14px;
}

.about-feature p {
  color: #7d8697;
  font-size: 11px;
  line-height: 1.7;
}


/* TECHNOLOGY */

.technology-section {
  padding: 90px 28px;

  background: #172033;
  color: white;
}

.technology-content {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 90px;
  align-items: center;
}

.technology-content h2 {
  margin: 10px 0 17px;

  color: white;

  font-size: 36px;
  line-height: 1.15;
  letter-spacing: -1px;
}

.technology-content h2 span {
  color: #7892ff;
}

.technology-content p {
  color: #8e9ab0;
  font-size: 12px;
  line-height: 1.8;
}

.technology-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.technology-grid > div {
  padding: 20px;

  border: 1px solid #2c3648;
  border-radius: 11px;

  background: #1c2637;
}

.technology-grid strong {
  display: block;

  margin-bottom: 5px;

  color: white;
  font-size: 14px;
}

.technology-grid span {
  color: #7e899e;
  font-size: 9px;
}


/* CTA */

.about-cta {
  padding: 75px 28px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 30px;

  background: #101725;
  color: white;
}

.about-cta > div:first-child {
  max-width: 1184px;
}

.about-cta h2 {
  margin-top: 8px;

  color: white;
  font-size: 32px;
  line-height: 1.2;
}

.about-cta h2 span {
  color: #7892ff;
}

.about-cta .cta-button {
  margin-right: 8%;
}


/* RESPONSIVE */

@media (max-width: 900px) {

  .about-two-column {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .about-steps {
    grid-template-columns: 1fr 1fr;
  }

  .technology-content {
    grid-template-columns: 1fr;
    gap: 40px;
  }

}

@media (max-width: 600px) {

  .about-section,
  .about-process,
  .technology-section {
    padding: 65px 20px;
  }

  .about-steps {
    grid-template-columns: 1fr;
  }

  .about-feature-grid {
    grid-template-columns: 1fr;
  }

  .technology-grid {
    grid-template-columns: 1fr;
  }

  .about-cta {
    padding: 60px 20px;

    flex-direction: column;
    align-items: flex-start;
  }

  .about-cta .cta-button {
    margin-right: 0;
  }

}
