# RentSmart Backend Configuration
# -------------------------------------------------------------
# Default: Local SQLite (automatically used if not specified)
DATABASE_URL=sqlite:///./rentsmart.db

# To use MySQL:
# 1. Create a MySQL database (e.g. `CREATE DATABASE rentsmart;`)
# 2. Uncomment and configure the connection URL below:
# DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/rentsmart

# Application Server Settings
PORT=8000
HOST=0.0.0.0
